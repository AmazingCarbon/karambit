{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karambit",
  "version": "0.1.0",
  "identifier": "dev.local.karambit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Karambit",
        "width": 1080,
        "height": 700,
        "minWidth": 700,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/karambit-se-helper"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
